;; @desc the selecting table holds a VARIABLE alongside its three ground rows. A stored
;; @desc variable unifies with everything, so `(root $x)` binds `$x` to a variable once and the
;; @desc `(edge $x $y)` after it has no key to seek on. The planner must price that step as the
;; @desc scan it is; answers may not depend on whether it does.
;; @desc
;; @desc This one is not a win. The planner accepts it and walks 24,979 transitions against
;; @desc the written order's 20,331, because it prices the whole column by its worst value
;; @desc while three of that table's four rows are in fact seekable. The point is that the
;; @desc loss is a BOUNDED constant -- 1.14x to 1.23x from 300 to 4,800 edges -- where
;; @desc without the stored-variable term it was 27x growing to 463x over the same range.
;; @steps 1
;; @expect-steps 1
;; @expect

(root n0)
(root n1)
(root n2)
(root $r)

(exec 0 (, (edge $x $y) (edge $y $z) (root $x) (edge $x $z)) (, (triangle $x $y $z)))

(edge n0 n3)
(edge n0 n5)
