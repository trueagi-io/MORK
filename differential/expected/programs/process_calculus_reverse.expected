(petri (! (add (PN (S Z) (S (S Z)))) ((S Z) (S (S Z)))))
(petri (! (add (PN Z (S (S Z)))) (Z (S (S Z)))))
(petri (! (add result) ((S (S Z)) (S (S Z)))))
(petri (! (PN (S Z) (S (S Z))) (S (S (S Z)))))
(petri (! (PN Z (S (S Z))) (S (S Z))))
(petri (! result (S (S (S (S Z))))))
(petri (| (! (add (PN (S Z) (S (S Z)))) ((S Z) (S (S Z)))) (? (PN (S Z) (S (S Z))) $a (! result (S $a)))))
(petri (| (! (add (PN Z (S (S Z)))) (Z (S (S Z)))) (? (PN Z (S (S Z))) $a (! (PN (S Z) (S (S Z))) (S $a)))))
(petri (? (add $a) ((S $b) $c) (| (! (add (PN $b $c)) ($b $c)) (? (PN $b $c) $d (! $a (S $d))))))
(petri (? (add $a) (Z $b) (! $a $b)))
(petri (? (PN (S Z) (S (S Z))) $a (! result (S $a))))
(petri (? (PN Z (S (S Z))) $a (! (PN (S Z) (S (S Z))) (S $a))))
((exec 0) (, (petri (! $a $b)) (petri (? $a $b $c))) (, (petri $c)))
((exec 1) (, (petri (| $a $b))) (, (petri $a) (petri $b)))
