;; @desc set disjointness by retraction (main.rs: roman_disjoin_final)
;; @expect

(set 1 a) (set 1 b) (set 1 c)
(set 2 d) (set 2 e) (set 2 f)
(set 3 a) (set 3 b)

(lt 1 2) (lt 1 3) (lt 2 3)

(exec 0 (, (set $a $ea))
        (, (elementOf $ea $a)))

(exec 0 (, (set $a $ea))
        (, (sets $a)))

(exec 0 (, (lt $a $b))
        (, (disjoint $a $b)))

(exec 0 (, (elementOf $ea $a) (elementOf $ea $b) )
        (O (- (disjoint $a $b))))
