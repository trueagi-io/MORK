(tree-example (branch (branch (leaf 11) (leaf 12)) (leaf 2)))
(space-example (value (cons (cons nil L) L) 11))
(space-example (value (cons (cons nil L) R) 12))
(space-example (value (cons nil R) 2))
(tree-to-space drop-tree (coalg (ctx (leaf $a) $b) (, (value $b $a))))
(tree-to-space lift-tree (coalg (tree $a) (, (ctx $a nil))))
(tree-to-space explode-tree (coalg (ctx (branch $a $b) $c) (, (ctx $a (cons $c L)) (ctx $b (cons $c R)))))
(rulify $a (, $b) (, $c) (, (tmp $b)) (O (- (tmp $b)) (+ (tmp $c)) (+ (has changed))))
(rulify $a (, $b) (, $c $d) (, (tmp $b)) (O (- (tmp $b)) (+ (tmp $c)) (+ (tmp $d)) (+ (has changed))))
