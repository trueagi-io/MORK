;; @desc   MORK.wiki "MM2-tutorial:-Reachability-P4", code block 4

(exec (1 0) (, (reachable Z $s $t) (t $t $u $a)     
               (step $i (path $s $t $pa) $a2) 
               (visited $v))
            (O (+ (reachable (S Z) $s $u))          ; extend paths of previous iteration
               (- (reachable (S Z) $s $v))          ; remove if target was already visited
               (+ (step $i (path $s $u ($a $pa)) $a2))  ; copy existing steps
               (- (step $i (path $s $v ($a $pa)) $a2))
               (+ (step (S Z) (path $s $u ($a $pa)) $a))  ; append new last step
               (- (step (S Z) (path $s $v ($a $pa)) $a))
               (+ (visited $u))))
